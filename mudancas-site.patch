+
+/* revelação ao rolar: estado oculto só com JS */
+.js .agendamentos [data-ag] { opacity: 0; transform: translateY(16px); }
+.agendamentos.is-in [data-ag] {
+  opacity: 1; transform: none;
+  transition: opacity .5s var(--ease), transform .5s var(--ease);
+  transition-delay: calc(var(--i, 0) * 60ms);
+}
+
+@media (max-width: 900px) {
+  .ag-steps { grid-template-columns: 1fr; }
+}
+@media (max-width: 640px) {
+  .agendamentos .ag-title { min-height: calc(var(--fs-h2) * 3.15); }
+  .ag-chip { flex: 1 1 calc(50% - 10px); }
+  .ag-btn { width: 100%; justify-content: center; }
+  .ag-stat { padding-inline: 16px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .js .agendamentos [data-ag] { transform: none; }
+  .agendamentos.is-in [data-ag] { transition: opacity .5s ease; transition-delay: 0s; }
+  .ag-subject { transition: none; }
+}
