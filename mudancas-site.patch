+  border-top: 1px solid rgba(228,171,89,.3);
+}
+.agendamentos [hidden] { display: none !important; }
+
+.ag-main { max-width: 720px; margin-inline: auto; text-align: center; }
+.agendamentos .ag-title {
+  font: 400 var(--fs-h2)/1.05 var(--serif); margin: 0 auto 24px; color: var(--ivory);
+  text-wrap: balance; min-height: calc(var(--fs-h2) * 2.1); text-align: center;
+}
+.agendamentos .ag-title em { color: var(--gold-light); }
