+.agendamentos .ag-step h3 { margin: 0 0 8px; font: 500 1.125rem/1.3 var(--sans); color: var(--ivory); }
+.ag-text { font-size: 1rem; line-height: 1.6; color: rgba(237,233,227,.85); max-width: 32ch; margin-inline: auto; }
+
